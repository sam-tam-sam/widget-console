# Copy these settings into Hostinger's Environment variables panel.
# Replace the example hostname and set a unique password of at least 15 characters.
WIDGET_PUBLIC_ORIGIN=https://widgets.example.com
WIDGET_ADMIN_USERNAME=example-admin
WIDGET_ADMIN_PASSWORD=

# Replace HOSTINGER_ACCOUNT and the example domain with the real File Manager path.
# Keep the SQLite file outside public_html and hbuilds, in a private writable directory.
# For an existing app, retain its exact working WIDGET_DB_PATH on future deployments.
WIDGET_DB_PATH=/home/HOSTINGER_ACCOUNT/domains/widgets.example.com/widget-data/widget-console.sqlite
WIDGET_TRUST_CLOUDFLARE=0

# Uncomment only when configuring publisher reports. Automatic browser counting works without it.
# WIDGET_ANALYTICS_PUBLISHER_KEYS=
