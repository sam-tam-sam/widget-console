# Copy these settings into Dockhand's Environment variables panel.
# Replace the example origin and set a strong, unique administrator password.
WIDGET_PUBLIC_ORIGIN=https://widgets.example.com
WIDGET_ADMIN_USERNAME=example-admin
WIDGET_ADMIN_PASSWORD=

# Optional settings shown with their Compose defaults.
# For an existing stack, retain its volume and network names.
WIDGET_HOST_PORT=3100
WIDGET_BIND_IP=127.0.0.1
WIDGET_VOLUME_NAME=widget-console-data
WIDGET_NETWORK_NAME=widget-console
WIDGET_TRUST_CLOUDFLARE=0
# Optional JSON object mapping each HTTPS publisher origin to its own 64-character hexadecimal key.
WIDGET_ANALYTICS_PUBLISHER_KEYS=
